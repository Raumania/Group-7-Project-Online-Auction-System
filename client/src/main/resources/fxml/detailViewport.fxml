<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="viewport-container" stylesheets="@../css/detailViewport.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction_system.client.controller.DetailViewportController">

    <!-- Increased padding from 20 to 30 to create breathing room -->
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="15.0" styleClass="content-card" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleBackToList" styleClass="btn-back" text="&lt; Back to list" />
                                <Label fx:id="itemNameLabel" styleClass="page-title" text="iPhone 15 Pro Max 256GB - Natural Titanium" />
                            </children>
                        </HBox>
                        <!-- Reduced minHeight of image frame from 300 to 200 -->
                        <VBox alignment="CENTER" maxHeight="300.0" minHeight="200.0" styleClass="image-preview-area">
                            <children>
                                <!-- Reduced image size to 240 -->
                                <ImageView fx:id="itemImageView" fitHeight="240.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/items/iphone%2036%20pro%20max.png" />
                                    </image>
                                </ImageView>
                            </children>
                        </VBox>

                        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                            <children>
                                <HBox spacing="30.0" styleClass="tab-container">
                                    <children>
                                        <Label styleClass="tab-item, tab-active" text="Description" />
                                    </children>
                                </HBox>
                                <Separator />

                                <ScrollPane fitToWidth="true" minHeight="0.0" prefHeight="200.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                            <Label fx:id="descriptionLabel" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" prefWidth="100.0" text="iPhone 36 Pro Max: The Era of Pocket Quantum Supercomputers. Apple has officially redefined the entire concept of mobile devices with the launch of the iPhone 36 Pro Max. Not just a smartphone, this device is actually a miniature quantum supercomputer, carrying unparalleled hardware power and opening the door to a sci-fi technology era right in the palm of your hand. Stealth Design &amp; Hologram Display: In terms of appearance, the iPhone 36 Pro Max has completely removed all ports, physical slots, and even buttons. The entire body is cast from ultra-light Titanium-Graphene alloy, providing tens of times the durability of stainless steel but weighing as light as a feather. The most impressive highlight is the 7.5-inch Holographic Quantum Retina display. This screen not only displays 2D images with high dynamic range, but also integrates a Hologram emitter. Users can directly interact multi-touch with UI/UX interface blocks floating in mid-air, turning any space before their eyes into an intuitive workspace. Processing Power Beyond Physical Limits: At the heart of the machine is the A36 Quantum Bionic processor, manufactured on a sub-atomic process. Its power surpasses the most advanced desktop computers and servers today. The Neural Engine core allows running Large Language Models (LLMs) and Artificial Intelligence (AI) completely independently on the device without internet. For the most complex tasks like compiling massive source code projects, managing large database systems, or rendering multi-dimensional graphics, this phone completes them in an instant without generating heat. &quot;Reality Capture&quot; Camera System: The camera cluster of the iPhone 36 Pro Max is completely hidden under the screen, using a quantum light sensor with a resolution of up to 500 Megapixels. The device can automatically reconstruct light in completely dark environments, producing photos as bright and clear as daytime. Moreover, the &quot;Reality Capture&quot; mode allows recording multi-dimensional spatial videos, capturing depth, temperature, and spatial audio data. When reviewing, users can &quot;step into&quot; that very moment and freely move their viewing angle. Era of Eternal Energy: The concept of &quot;charging battery&quot; or &quot;running out of battery&quot; has become a thing of the past with the iPhone 36 Pro Max. The device uses a Nano-Diamond battery core combined with Ambient Power Harvesting capability. The phone will automatically collect and convert radio waves in the surrounding environment (like Wi-Fi, cellular signals) into continuous energy. Even when running heavy software at maximum performance, the device can still maintain endless endurance without needing to be physically plugged in. Perfect Interface &amp; Absolute Security: The iOS 36 operating system is designed minimalist but exceptionally smart. Dark Mode is perfectly fine-tuned to every pixel with deep blacks, absolutely protecting eyes in low-light workspaces or working overnight. In addition, all user data is protected by multi-layer quantum-standard encryption and password hashing mechanisms, ensuring absolute safety against all cyber security risks. In conclusion, the iPhone 36 Pro Max is not just an upgrade, but a giant leap in human technology, breaking all physical barriers to turn the impossible into reality." wrapText="true" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Reduced spacing from 20 to 15 to be less cramped -->
                <VBox minWidth="380.0" prefWidth="380.0" spacing="15.0" styleClass="content-card">
                    <children>
                        <VBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label styleClass="text-muted" text="STATUS" />
                                <Label fx:id="statusLabel" styleClass="badge-running" text="● RUNNING" />
                            </children>
                        </VBox>
                        <Separator />

                        <VBox spacing="15.0">
                            <children>
                                <Label styleClass="section-subtitle" text="Item information" />
                                <GridPane vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0" />
                                        <ColumnConstraints halignment="RIGHT" percentWidth="50.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints />
                                        <RowConstraints />
                                    </rowConstraints>
                                    <children>
                                        <Label styleClass="text-muted" text="👤 Seller:" />
                                        <Label fx:id="sellerUsernameLabel" styleClass="text-bold" text="Tran Vu Duc" GridPane.columnIndex="1" />
                                        <Label styleClass="text-muted" text="🏷 Category:" GridPane.rowIndex="1" />
                                        <Label fx:id="categoryLabel" styleClass="text-bold" text="Electronics" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <Separator />

                        <VBox spacing="15.0">
                            <children>
                                <Label styleClass="section-subtitle" text="Price &amp; Time" />
                                <GridPane vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0" />
                                        <ColumnConstraints halignment="RIGHT" percentWidth="50.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints />
                                        <RowConstraints />
                                    </rowConstraints>
                                    <children>
                                        <Label styleClass="text-muted" text="💰 Starting price:" />
                                        <Label fx:id="startingPriceLabel" styleClass="text-bold-blue" text="\$1,000.00" GridPane.columnIndex="1" />
                                        <Label styleClass="text-muted" text="🔥 Current price:" GridPane.rowIndex="1" />
                                        <Label fx:id="currentPriceLabel" styleClass="text-bold-green" text="\$1,250.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                            <children>
                                <Label styleClass="text-muted" text="Remaining time:" />
                                <HBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <VBox alignment="CENTER" prefHeight="55.0" prefWidth="60.0" styleClass="countdown-box">
                                            <children>
                                                <Label fx:id="hourLabel" styleClass="cd-number" text="02" />
                                                <Label styleClass="cd-text" text="Hour" />
                                            </children>
                                        </VBox>
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 20px;" text=":" />
                                        <VBox alignment="CENTER" prefHeight="55.0" prefWidth="60.0" styleClass="countdown-box">
                                            <children>
                                                <Label fx:id="minLabel" styleClass="cd-number" text="15" />
                                                <Label styleClass="cd-text" text="Minute" />
                                            </children>
                                        </VBox>
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 20px;" text=":" />
                                        <VBox alignment="CENTER" prefHeight="55.0" prefWidth="60.0" styleClass="countdown-box">
                                            <children>
                                                <Label fx:id="secLabel" styleClass="cd-number" text="30" />
                                                <Label styleClass="cd-text" text="Second" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleJoinRoom" styleClass="btn-join-room" text="🔨 Enter live auction room" />
                                <Label styleClass="text-small" text="🛡 Enter now!" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
