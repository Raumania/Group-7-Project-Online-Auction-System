<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-root" stylesheets="@../css/mainAuction.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction_system.client.controllers.MainAuctionController">

   <!-- TOP BAR (HEADER) -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="app-title" text="Online Auction" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <TextField prefWidth="350.0" promptText="Search for auctions..." styleClass="search-field" />
                  <Button styleClass="search-btn" text="Search" />
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="user-name-header" text="Tran Vu Duc" />
         </children>
      </HBox>
   </top>

   <!-- SIDEBAR (LEFT) -->
   <left>
      <VBox prefWidth="250.0" spacing="15.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Button maxWidth="1.7976931348623157E308" onAction="#listViewportBtn" styleClass="sidebar-btn" text="📋 Auction List" />
            <Button maxWidth="1.7976931348623157E308" onAction="#sellerViewportBtn" styleClass="sidebar-btn" text="📦 My Items" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- User Info Card -->
            <VBox spacing="10.0" styleClass="user-info-card">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label prefHeight="46.0" prefWidth="38.0" styleClass="user-icon" text="👤" />
                        <VBox prefHeight="46.0" prefWidth="139.0">
                           <children>
                              <Label styleClass="text-white-bold" text="Tran Vu Duc" />
                              <Label styleClass="text-muted" text="52ducbanh" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="text-muted" text="Balance" />
                        <Label styleClass="text-balance" text="\$36,000,000" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <Button maxWidth="1.7976931348623157E308" onAction="#logoutBtn" styleClass="logout-btn" text="[→ Logout" />
         </children>
      </VBox>
   </left>

   <!-- MAIN CONTENT (CENTER) -->
   <center>
      <BorderPane styleClass="main-content" BorderPane.alignment="CENTER">

         <!-- Filters & Title -->
         <top>
            <VBox spacing="15.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox spacing="15.0">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="text-muted" text="Categories" />
                              <ComboBox maxWidth="1.7976931348623157E308" promptText="All Categories" styleClass="combo-box-filter" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="text-muted" text="Status" />
                              <ComboBox maxWidth="1.7976931348623157E308" promptText="All Status" styleClass="combo-box-filter" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="text-muted" text="Sort By" />
                              <ComboBox maxWidth="1.7976931348623157E308" promptText="Ending Soon" styleClass="combo-box-filter" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </top>
         <center>
            <StackPane fx:id="viewport" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
         </center>

      </BorderPane>
   </center>
</BorderPane>
