<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="viewport-container" stylesheets="@../css/detailViewport.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction_system.client.controller.DetailViewportController">

    <!-- Đã tăng padding từ 20 lên 30 để tạo khoảng thở -->
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleBackToList" styleClass="btn-back" text="&lt; Back to list" />
                <Label styleClass="page-title" text="iPhone 15 Pro Max 256GB - Natural Titanium" />
            </children>
        </HBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="15.0" styleClass="content-card" HBox.hgrow="ALWAYS">
                    <children>
                        <!-- Giảm minHeight của khung ảnh từ 300 xuống 200 -->
                        <VBox alignment="CENTER" maxHeight="300.0" minHeight="200.0" styleClass="image-preview-area">
                            <children>
                                <!-- Giảm kích thước ảnh xuống 240 -->
                                <ImageView fitHeight="240.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/items/iphone%2036%20pro%20max.png" />
                                    </image>
                                </ImageView>
                            </children>
                        </VBox>

                        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                            <children>
                                <HBox spacing="30.0" styleClass="tab-container">
                                    <children>
                                        <Label styleClass="tab-item, tab-active" text="Description" />
                                    </children>
                                </HBox>
                                <Separator />

                                <ScrollPane fitToWidth="true" minHeight="0.0" prefHeight="200.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <Label maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" prefWidth="100.0" text="iPhone 36 Pro Max: Kỷ Nguyên Của Siêu Máy Tính Lượng Tử Bỏ TúiApple vừa chính thức định nghĩa lại toàn bộ khái niệm về thiết bị di động với sự kiện ra mắt iPhone 36 Pro Max. Không chỉ đơn thuần là một chiếc điện thoại thông minh, thiết bị này thực chất là một siêu máy tính lượng tử thu nhỏ, mang trong mình sức mạnh phần cứng vô song và là cánh cửa mở ra một kỷ nguyên công nghệ viễn tưởng ngay trong lòng bàn tay.Thiết Kế Tàng Hình &amp; Màn Hình HologramVề mặt ngoại hình, iPhone 36 Pro Max đã loại bỏ hoàn toàn các cổng kết nối, khe cắm vật lý và cả nút bấm. Toàn bộ thân máy được đúc nguyên khối từ hợp kim Titanium-Graphene siêu nhẹ, cho độ bền gấp hàng chục lần so với thép không gỉ nhưng trọng lượng lại nhẹ tựa lông hồng. Điểm nhấn ấn tượng nhất chính là màn hình Holographic Quantum Retina kích thước 7.5 inch. Màn hình này không chỉ hiển thị hình ảnh 2D với dải tương phản cao, mà còn tích hợp bộ phát Hologram. Người dùng có thể trực tiếp thao tác đa điểm với các khối giao diện UI/UX lơ lửng trong không trung, biến mọi không gian trước mắt thành môi trường làm việc trực quan.Sức Mạnh Xử Lý Vượt Giới Hạn Vật LýNằm ở trung tâm của cỗ máy là vi xử lý A36 Quantum Bionic, được chế tạo trên tiến trình hạ nguyên tử (sub-atomic). Sức mạnh của nó vượt qua các dàn máy tính để bàn và máy chủ tối tân nhất hiện nay. Lõi Neural Engine cho phép chạy các mô hình Ngôn ngữ Lớn (LLMs) và Trí tuệ Nhân tạo (AI) hoàn toàn độc lập ngay trên thiết bị mà không cần internet. Đối với những tác vụ phức tạp nhất như biên dịch những dự án mã nguồn khổng lồ, quản trị hệ cơ sở dữ liệu lớn hay kết xuất đồ họa đa chiều, chiếc điện thoại này đều hoàn thành trong tích tắc mà không hề phát sinh nhiệt lượng.Hệ Thống Camera &quot;Reality Capture&quot;Cụm camera của iPhone 36 Pro Max được đặt ẩn hoàn toàn dưới màn hình, sử dụng cảm biến ánh sáng lượng tử với độ phân giải lên tới 500 Megapixel. Thiết bị có khả năng tự động tái tạo ánh sáng trong môi trường tối hoàn toàn, cho ra những bức ảnh sáng rõ như ban ngày. Hơn thế nữa, chế độ &quot;Reality Capture&quot; cho phép quay video không gian đa chiều, ghi lại cả dữ liệu về chiều sâu, nhiệt độ và âm thanh không gian. Khi xem lại, người dùng có thể &quot;bước vào&quot; chính khoảnh khắc đó và tự do di chuyển góc nhìn.Kỷ Nguyên Năng Lượng Vĩnh CửuKhái niệm &quot;sạc pin&quot; hay &quot;hết pin&quot; đã trở thành dĩ vãng với iPhone 36 Pro Max. Thiết bị sử dụng lõi pin công nghệ Nano-Diamond kết hợp cùng khả năng sạc qua không gian (Ambient Power Harvesting). Điện thoại sẽ tự động thu thập và chuyển hóa các sóng vô tuyến trong môi trường xung quanh (như Wi-Fi, sóng di động) thành năng lượng liên tục. Thậm chí khi chạy các phần mềm nặng với hiệu suất tối đa, thiết bị vẫn có thể duy trì sự bền bỉ vô tận mà không cần cắm điện vật lý.Giao Diện Hoàn Mỹ &amp; Bảo Mật Tuyệt ĐốiHệ điều hành iOS 36 được thiết kế tối giản nhưng thông minh vượt bậc. Chế độ Dark Mode được tinh chỉnh hoàn hảo tới từng pixel với độ đen sâu thẳm, giúp bảo vệ mắt tuyệt đối trong các môi trường làm việc thiếu sáng hoặc làm việc xuyên đêm. Bên cạnh đó, toàn bộ dữ liệu của người dùng được bảo vệ bằng cơ chế mã hóa và băm mật khẩu chuẩn lượng tử đa tầng, đảm bảo an toàn tuyệt đối trước mọi rủi ro về an ninh mạng.Tổng kết lại, iPhone 36 Pro Max không chỉ là một sự nâng cấp, mà là một bước nhảy vọt vĩ đại của công nghệ nhân loại, phá vỡ mọi rào cản vật lý để biến những điều không tưởng thành hiện thực." wrapText="true" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Giảm spacing từ 20 xuống 15 để bớt chật chội -->
                <VBox minWidth="380.0" prefWidth="380.0" spacing="15.0" styleClass="content-card">
                    <children>
                        <VBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label styleClass="text-muted" text="STATUS" />
                                <Label styleClass="badge-running" text="● RUNNING" />
                            </children>
                        </VBox>
                        <Separator />

                        <VBox spacing="15.0">
                            <children>
                                <Label styleClass="section-subtitle" text="Item information" />
                                <GridPane vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0" />
                                        <ColumnConstraints halignment="RIGHT" percentWidth="50.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints />
                                        <RowConstraints />
                                    </rowConstraints>
                                    <children>
                                        <Label styleClass="text-muted" text="👤 Seller:" />
                                        <Label styleClass="text-bold" text="Tran Vu Duc" GridPane.columnIndex="1" />
                                        <Label styleClass="text-muted" text="🏷 Category:" GridPane.rowIndex="1" />
                                        <Label styleClass="text-bold" text="Electronics" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>
                        <Separator />

                        <VBox spacing="15.0">
                            <children>
                                <Label styleClass="section-subtitle" text="Price &amp; Time" />
                                <GridPane vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0" />
                                        <ColumnConstraints halignment="RIGHT" percentWidth="50.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints />
                                        <RowConstraints />
                                    </rowConstraints>
                                    <children>
                                        <Label styleClass="text-muted" text="💰 Starting price:" />
                                        <Label styleClass="text-bold-blue" text="\$1,000.00" GridPane.columnIndex="1" />
                                        <Label styleClass="text-muted" text="🔥 Current price:" GridPane.rowIndex="1" />
                                        <Label styleClass="text-bold-green" text="\$1,250.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                            <children>
                                <Label styleClass="text-muted" text="Remaining time:" />
                                <HBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <VBox alignment="CENTER" prefHeight="55.0" prefWidth="60.0" styleClass="countdown-box">
                                            <children>
                                                <Label styleClass="cd-number" text="02" />
                                                <Label styleClass="cd-text" text="Hour" />
                                            </children>
                                        </VBox>
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 20px;" text=":" />
                                        <VBox alignment="CENTER" prefHeight="55.0" prefWidth="60.0" styleClass="countdown-box">
                                            <children>
                                                <Label styleClass="cd-number" text="15" />
                                                <Label styleClass="cd-text" text="Minute" />
                                            </children>
                                        </VBox>
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 20px;" text=":" />
                                        <VBox alignment="CENTER" prefHeight="55.0" prefWidth="60.0" styleClass="countdown-box">
                                            <children>
                                                <Label styleClass="cd-number" text="30" />
                                                <Label styleClass="cd-text" text="Second" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <Button maxWidth="1.7976931348623157E308" onAction="#handleJoinRoom" styleClass="btn-join-room" text="🔨 Enter live auction room" />
                                <Label styleClass="text-small" text="🛡 Enter now!" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>