<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefWidth="220.0" spacing="10.0" styleClass="auction-card" stylesheets="@../css/itemCard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/items/iphone%2036%20pro%20max.png" />
         </image>
      </ImageView>
      <Label styleClass="text-white-bold" text="iPhone 36 Pro Max" />
      <Label styleClass="card-tag" text="Electronics" />
      <Label styleClass="card-price" text="\$1,000" />
      <Label style="-fx-font-size: 10px;" styleClass="text-muted" text="Highest Bidder: user123" />
      <HBox alignment="CENTER" spacing="10.0" styleClass="timer-box">
         <children>
            <VBox alignment="CENTER">
               <children>
                  <Label styleClass="timer-num" text="02" />
                  <Label styleClass="timer-label" text="HRS" />
               </children>
            </VBox>
            <Label styleClass="timer-colon" text=":" />
            <VBox alignment="CENTER">
               <children>
                  <Label styleClass="timer-num" text="15" />
                  <Label styleClass="timer-label" text="MINS" />
               </children>
            </VBox>
            <Label styleClass="timer-colon" text=":" />
            <VBox alignment="CENTER">
               <children>
                  <Label styleClass="timer-num" text="30" />
                  <Label styleClass="timer-label" text="SECS" />
               </children>
            </VBox>
         </children>
      </HBox>
      <Button maxWidth="1.7976931348623157E308" styleClass="place-bid-btn" text="Place Bid" />
   </children>
</VBox>
